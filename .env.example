# Copy to .env.local for development.
#
# Any standard Postgres connection string works here, including a hosted
# Supabase Postgres instance in production — Supabase's Postgres is just
# Postgres, so no code changes are needed to point at it.
DATABASE_URL=postgres://edm_app:edm_dev_password@127.0.0.1:5432/edm_dev

# Shared secret required in the `x-sync-token` header to trigger a source
# sync via /api/sync/[source]. Generate a real random value in production;
# this is a placeholder for local development only. The same value must
# also be set as the SYNC_TRIGGER_TOKEN secret on whatever calls this
# endpoint on a schedule (see .github/workflows/sync-hangaren.yml).
SYNC_TRIGGER_TOKEN=dev-local-sync-token

# HTTP Basic Auth credentials gating /admin and /api/admin/* (src/proxy.ts).
# Required in production — if either is unset, /admin is denied outright
# rather than left open. Not a full user-management system by design; a
# single shared credential pair for a small internal admin tool.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# OPTIONAL. Discogs personal access token for genre enrichment
# (src/lib/enrichment/discogsClient.ts). Enrichment works without this —
# unauthenticated Discogs requests are allowed, just capped at 25/min
# instead of 60/min — so this is a recommended production upgrade, not a
# hard requirement. Generate one at https://www.discogs.com/settings/developers
# ("Generate new token") and set it here / as a Vercel project env var. Sent
# only in the Authorization header of Discogs API requests, never logged.
DISCOGS_TOKEN=

# OPTIONAL. YouTube Data API v3 key for the automated Artist Preview matcher
# (src/lib/enrichment/youtubeClient.ts) — Rule A only, see
# src/lib/enrichment/youtubePreviewMatching.ts. Every useful endpoint
# (search.list, videos.list) requires a key; there is no unauthenticated
# fallback the way Discogs has one, so with this unset, matching is skipped
# entirely for any artist name not already cached (never blocks event
# ingestion — see src/db/writes.ts::createEvent) and no preview is shown.
# Generate one at https://console.cloud.google.com/apis/credentials after
# enabling "YouTube Data API v3" on a project. Sent only as a `key=` query
# parameter on YouTube API requests, never logged (see
# src/lib/enrichment/youtubeClient.ts's own doc comment).
YOUTUBE_API_KEY=

# Server-side only — never prefixed NEXT_PUBLIC_, so these never reach the
# browser bundle. Power the /contact and /suggest-event forms
# (src/lib/email.ts, src/app/api/contact, src/app/api/suggest-event), which
# send email via Resend (https://resend.com) instead of a mailbox on
# electroniccph.com. All three are required in production — if any is
# unset, form submission fails closed with a generic error rather than
# silently dropping the message.

# Resend API key. Create one at https://resend.com/api-keys after verifying
# a sending domain (see CONTACT_FROM_EMAIL below).
RESEND_API_KEY=

# Where form submissions are delivered — a real inbox you already own
# (e.g. your personal address). This does NOT need to be @electroniccph.com;
# no mailbox needs to exist on that domain.
CONTACT_RECIPIENT_EMAIL=

# The "From" address Resend sends as. Must be on a domain verified in the
# Resend dashboard (Domains > Add Domain) via its generated DNS records —
# typically a subdomain like send.electroniccph.com, so reputation stays
# isolated from any existing mail on the root domain. Verification only
# needs DNS records added at your registrar; it does not require an actual
# mailbox to exist at this address.
CONTACT_FROM_EMAIL=Electronic CPH <hello@send.electroniccph.com>

# DISABLED (2026-10-06) — the "new Discovery Queue item" email notification
# was deliberately turned off; notifyDiscoveryQueueInsert/Batch
# (src/lib/discoveryNotification.ts) are now unconditional no-ops, so this
# variable is no longer read. Left here only as a record — setting it has
# no effect.
DISCOVERY_QUEUE_NOTIFICATION_EMAIL=

# Single switch for the entire weekly newsletter feature (signup form on
# the homepage, footer link, privacy-page paragraph, subscribe/send API
# routes) — see src/lib/newsletter/featureFlag.ts. Deliberately absent/unset
# by default: the newsletter is fully built but must stay invisible and
# inert until a human explicitly sets this to "true" (any other value,
# including unset, is treated as disabled). Reuses RESEND_API_KEY/
# CONTACT_FROM_EMAIL above — no separate email config needed. Reuses
# SYNC_TRIGGER_TOKEN above to authenticate the weekly send trigger (see
# .github/workflows/send-newsletter.yml), same as every existing sync
# endpoint. Before setting this to "true" in Production: confirm Resend's
# domain-level open/click tracking is turned off (there is no per-send
# toggle for it — see src/lib/email.ts::sendNewsletterEmail's doc comment),
# and add the `schedule` trigger to send-newsletter.yml, which is
# deliberately workflow_dispatch-only until then.
NEWSLETTER_SIGNUP_ENABLED=

# OPTIONAL, TEMPORARY. Comma-separated exact email addresses allowed to
# subscribe to and receive the newsletter WHILE NEWSLETTER_SIGNUP_ENABLED
# is unset/false (newsletter activation safety round, 2026-10-06) — see
# src/lib/newsletter/testAllowlist.ts. Lets a controlled end-to-end test
# run against real test addresses without exposing public signup: the
# signup form stays hidden (it's gated on the same flag), and the weekly
# send job is scoped to exactly these addresses, enforced independently at
# selection, claiming, and the final per-row send check — never "every
# confirmed subscriber". Unset or empty means no test access at all, same
# as leaving this blank entirely. Ignored completely once
# NEWSLETTER_SIGNUP_ENABLED is actually "true" — set this ONLY for the
# duration of a controlled test, then unset it again.
NEWSLETTER_TEST_ALLOWLIST=
