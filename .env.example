# Copy to .env.local for development.
#
# Any standard Postgres connection string works here, including a hosted
# Supabase Postgres instance in production — Supabase's Postgres is just
# Postgres, so no code changes are needed to point at it.
DATABASE_URL=postgres://edm_app:edm_dev_password@127.0.0.1:5432/edm_dev

# Shared secret required in the `x-sync-token` header to trigger a source
# sync via /api/sync/[source]. Generate a real random value in production;
# this is a placeholder for local development only. The same value must
# also be set as the SYNC_TRIGGER_TOKEN secret on whatever calls this
# endpoint on a schedule (see .github/workflows/sync-hangaren.yml).
SYNC_TRIGGER_TOKEN=dev-local-sync-token

# HTTP Basic Auth credentials gating /admin and /api/admin/* (src/proxy.ts).
# Required in production — if either is unset, /admin is denied outright
# rather than left open. Not a full user-management system by design; a
# single shared credential pair for a small internal admin tool.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# OPTIONAL. Discogs personal access token for genre enrichment
# (src/lib/enrichment/discogsClient.ts). Enrichment works without this —
# unauthenticated Discogs requests are allowed, just capped at 25/min
# instead of 60/min — so this is a recommended production upgrade, not a
# hard requirement. Generate one at https://www.discogs.com/settings/developers
# ("Generate new token") and set it here / as a Vercel project env var. Sent
# only in the Authorization header of Discogs API requests, never logged.
DISCOGS_TOKEN=

# Server-side only — never prefixed NEXT_PUBLIC_, so these never reach the
# browser bundle. Power the /contact and /suggest-event forms
# (src/lib/email.ts, src/app/api/contact, src/app/api/suggest-event), which
# send email via Resend (https://resend.com) instead of a mailbox on
# electroniccph.com. All three are required in production — if any is
# unset, form submission fails closed with a generic error rather than
# silently dropping the message.

# Resend API key. Create one at https://resend.com/api-keys after verifying
# a sending domain (see CONTACT_FROM_EMAIL below).
RESEND_API_KEY=

# Where form submissions are delivered — a real inbox you already own
# (e.g. your personal address). This does NOT need to be @electroniccph.com;
# no mailbox needs to exist on that domain.
CONTACT_RECIPIENT_EMAIL=

# The "From" address Resend sends as. Must be on a domain verified in the
# Resend dashboard (Domains > Add Domain) via its generated DNS records —
# typically a subdomain like send.electroniccph.com, so reputation stays
# isolated from any existing mail on the root domain. Verification only
# needs DNS records added at your registrar; it does not require an actual
# mailbox to exist at this address.
CONTACT_FROM_EMAIL=Electronic CPH <hello@send.electroniccph.com>

# OPTIONAL. Recipient for the "new Discovery Queue item" notification (sent
# once per genuinely new pending row — never on updates to an existing one;
# see src/lib/discoveryNotification.ts). Reuses RESEND_API_KEY and
# CONTACT_FROM_EMAIL above, so no separate sender config is needed. Leave
# blank to disable the notification entirely — source sync and the admin
# "Add event from URL" tool both work fine without it.
DISCOVERY_QUEUE_NOTIFICATION_EMAIL=
