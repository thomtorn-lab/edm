      {
        "band_name": "Fulci ",
        "band_description": "Fulci, opkaldt efter den legendariske italienske filmmager og ”Godfather of Gore”, Lucio Fulci, har genopfundet death metal-genren. Bandet kombinerer knusende riffs med en unik cinematisk atmosfære, der forvandler deres koncerter til levende soundtracks af kult-horrorfilm. Ved at transformere æstetikken fra klassiske splatterfilm til lyd, skaber Fulci en oplevelse, der føles som et sonisk mareridt i ordets mest medrivende forstand.",
        "image": "https://pumpehuset.dk/wp-content/uploads/fulci-credit-Alec-Basse02.jpg",
        "spotify": "https://open.spotify.com/embed/track/0eb5uIoYyvh86JIJXp3vHO?"
      },
      {
        "band_name": "MASTER BOOT RECORD",
        "band_description": "Aftenens andet hovednavn, Master Boot Record (MBR), ledes af den multitalentfulde producer Vittorio D’Amore. MBR er aktuel med sit tredje album på Metal Blade Records, Hardwarez, der udforsker dualiteten mellem teknologi og menneskehed. Projektet startede som et anonymt undergrundsprojekt i 2016, men har siden udviklet sig til en global magtfaktor i krydsfeltet mellem heavy metal, chiptune og klassisk musik.<br />\r\nMed Hardwarez har MBR opgraderet sit karakteristiske udtryk ved for første gang at inkludere rigtige guitar-overdubs side om side med de MIDI-programmerede synth-guitarer. \"Maskiner har stadig brug for os for at skinne,\" forklarer D’Amore, der live blander topmoderne teknologi med vintage-udstyr som Commodore 64 og Amiga 500 for at skabe en massiv og levende lydmur.<br />\r\nMaster Boot Record har toppet hitlisterne på Bandcamp og turneret intensivt på tværs af USA og Europa, herunder optrædener på store festivaler som Wacken Open Air og Brutal Assault.",
        "image": "https://pumpehuset.dk/wp-content/uploads/master-boot-record-kvadrat.jpg",
        "spotify": "https://open.spotify.com/embed/track/0gWWHHxdPOGrda1IXGpDoY?"
      },
      {
        "band_name": "arottenbit ",
        "band_description": "Som support har de italienske arottenbit, det eksperimenterende musikprojekt der blander chiptune, sludge metal, techno og hardcore punk i et elektronisk univers.",
        "image": "https://pumpehuset.dk/wp-content/uploads/AROTTENBIT.jpeg",
        "spotify": "https://open.spotify.com/embed/track/2iDACWU2GafMyVJtz0c8yK?"
      }
