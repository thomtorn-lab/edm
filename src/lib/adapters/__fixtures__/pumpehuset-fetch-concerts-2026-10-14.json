icketmaster.dk\/","ticket_status":"Normal","link":"https:\/\/pumpehuset.dk\/koncerter\/elgrandetoto\/","genre":"Hiphop"},{"title":"Tinie Tempah","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/Tinie-Tempah.jpg","support_bands":false,"custom_support_title":null,"hide_support_title":null,"date":"17. nov 2026","date_list":"17. nov","year_list":"2026","price":"300","ticket_link":"https:\/\/www.ticketmaster.dk\/event\/1963814752?language=da-dk&brand=dk_atl","ticket_status":"Normal","link":"https:\/\/pumpehuset.dk\/koncerter\/tinie-tempah\/","genre":"Hiphop"},{"title":"Karoline Mousing","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/Karoline-mousing-hjside-e1770109336340.jpg","support_bands":[{"band_name":"Support: Klara Vibeke","band_description":"Den 19-\u00e5rige Klara Vibekes visuelle og musikalske univers bygger p\u00e5 st\u00e6rke kontraster. Her flettes street-wear, edgy hiphop-referencer og kompromisl\u00f8s attitude ubesv\u00e6ret sammen <br \/>\r\nmed feminin charme og f\u00e6ngende popmelodier. <br \/>\r\nHun tog sine f\u00f8rste solide skridt ind p\u00e5 den danske musikscene med debutsinglen \u2019passer p\u00e5 mit K\u2019 i sommeren 2026, og f\u00f8lger nu op med singlen \u2019st\u00e5r for skud<\/3\u2019. Den nye single viser en artist, der ikke har t\u00e6nkt sig at undskylde for sig selv, og som med oprejst pande tager fuld kontrol over sin egen historie.","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/Klara-Vibeke.jpg","spotify":"https:\/\/open.spotify.com\/embed\/track\/4Vv8Zh3tdP2I67fbIFLOCF?"}],"custom_support_title":"","hide_support_title":false,"date":"19. nov 2026","date_list":"19. nov","year_list":"2026","price":"250","ticket_link":"https:\/\/billet.unitedtickets.dk\/event\/karoline-mousing\/pumpehuset-copenhagen\/3593575","ticket_status":"Udsolgt","link":"https:\/\/pumpehuset.dk\/koncerter\/karoline-mousing\/","genre":"Pop"},{"title":"BODYSLAM Wrestling - WrestleWonderland\u2028","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/BODYSLAM-Pumpehuset20nov2026_2.jpg","support_bands":false,"custom_support_title":null,"hide_support_title":null,"date":"20. nov 2026","date_list":"20. nov","year_list":"2026","price":"300","ticket_link":"https:\/\/secure.tickster.com\/da\/9bdaf7pr5tvfag4\/products","ticket_status":"Normal","link":"https:\/\/pumpehuset.dk\/koncerter\/bodyslam-wrestling-wrestlewonderland\/","genre":null},{"title":"Trinix","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/trinix-scaled-e1770811665272.jpg","support_bands":false,"custom_support_title":"","hide_support_title":false,"date":"21. nov 2026","date_list":"21. nov","year_list":"2026","price":"320","ticket_link":"https:\/\/www.billetlugen.dk\/event\/21283463\/?affiliate=SB8","ticket_status":"Normal","link":"https:\/\/pumpehuset.dk\/koncerter\/trinix\/","genre":"Elektronisk"},{"title":"MASTER BOOT RECORD + Fulci","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/master-boot-record-horizon.jpg","support_bands":[{"band_name":"Fulci ","band_description":"Fulci, opkaldt efter den legendariske italienske filmmager og \u201dGodfather of Gore\u201d, Lucio Fulci, har genopfundet death metal-genren. Bandet kombinerer knusende riffs med en unik cinematisk atmosf\u00e6re, der forvandler deres koncerter til levende soundtracks af kult-horrorfilm. Ved at transformere \u00e6stetikken fra klassiske splatterfilm til lyd, skaber Fulci en oplevelse, der f\u00f8les som et sonisk mareridt i ordets mest medrivende forstand.","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/fulci-credit-Alec-Basse02.jpg","spotify":"https:\/\/open.spotify.com\/embed\/track\/0eb5uIoYyvh86JIJXp3vHO?"},{"band_name":"MASTER BOOT RECORD","band_description":"Aftenens andet hovednavn, Master Boot Record (MBR), ledes af den multitalentfulde producer Vittorio D\u2019Amore. MBR er aktuel med sit tredje album p\u00e5 Metal Blade Records, Hardwarez, der udforsker dualiteten mellem teknologi og menneskehed. Projektet startede som et anonymt undergrundsprojekt i 2016, men har siden udviklet sig til en global magtfaktor i krydsfeltet mellem heavy metal, chiptune og klassisk musik.<br \/>\r\nMed Hardwarez har MBR opgraderet sit karakteristiske udtryk ved for f\u00f8rste gang at inkludere rigtige guitar-overdubs side om side med de MIDI-programmerede synth-guitarer. \"Maskiner har stadig brug for os for at skinne,\" forklarer D\u2019Amore, der live blander topmoderne teknologi med vintage-udstyr som Commodore 64 og Amiga 500 for at skabe en massiv og levende lydmur.<br \/>\r\nMaster Boot Record har toppet hitlisterne p\u00e5 Bandcamp og turneret intensivt p\u00e5 tv\u00e6rs af USA og Europa, herunder optr\u00e6dener p\u00e5 store festivaler som Wacken Open Air og Brutal Assault.","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/master-boot-record-kvadrat.jpg","spotify":"https:\/\/open.spotify.com\/embed\/track\/0gWWHHxdPOGrda1IXGpDoY?"},{"band_name":"arottenbit ","band_description":"Som support har de italienske arottenbit, det eksperimenterende musikprojekt der blander chiptune, sludge metal, techno og hardcore punk i et elektronisk univers.","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/AROTTENBIT.jpeg","spotify":"https:\/\/open.spotify.com\/embed\/track\/2iDACWU2GafMyVJtz0c8yK?"}],"custom_support_title":"","hide_support_title":false,"date":"22. nov 2026","date_list":"22. nov","year_list":"2026","price":"300","ticket_link":"https:\/\/www.ticketmaster.dk\/event\/master-boot-record-fulci-co-headline--billetter\/1020215370","ticket_status":"Normal","link":"https:\/\/pumpehuset.dk\/koncerter\/master-boot-record-fulci\/","genre":"Elektronisk"},{"title":"BLACKGOLD","image":"https:\/\/pumpehuset.dk\/wp-content\/uploads\/Black-Gold-Promo-@abbidraperphoto.jpg","support_bands":[{"band_name":"Support: Sumo Cyco","band_description":"","image":false,"spotify":"https:\/\/open.spotify.com\/embed\/track\/087SikAadMJppgGnjx2pWu?"}],"custom_support_title":"","hide_support_title":false,"date":"23. nov 2026","date_list":"2