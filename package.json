{
  "name": "edm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --env-file=.env.local node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file=.env.local node_modules/.bin/drizzle-kit studio",
    "db:seed:dev": "node --env-file=.env.local --import tsx src/db/seedDev.ts",
    "db:seed:production": "node --env-file=.env.local --import tsx src/db/bootstrapProduction.ts",
    "db:verify-sync": "node --env-file=.env.local --import tsx src/db/verifySync.ts",
    "db:verify-bootstrap": "node --env-file=.env.local --import tsx src/db/verifyProductionBootstrap.ts",
    "db:check-source-health": "node --env-file=.env.local --import tsx src/db/checkSourceHealth.ts",
    "db:inspect-source": "node --env-file=.env.local --import tsx src/db/inspectSource.ts",
    "db:sync-source-registry": "node --env-file=.env.local --import tsx src/db/syncSourceRegistry.ts"
  },
  "dependencies": {
    "@fontsource/big-shoulders": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
