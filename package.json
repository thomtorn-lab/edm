{
  "name": "edm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --env-file=.env.local node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file=.env.local node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file=.env.local --import tsx src/db/seed.ts",
    "db:verify-sync": "node --env-file=.env.local --import tsx src/db/verifySync.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
